{
  "name": "defectdojo-http-api-mcp",
  "version": "0.1.0",
  "description": "MCP server for DefectDojo over HTTP API (findings triage)",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "defectdojo-http-api-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "lib",
    "README.md",
    "LICENSE",
    "ONBOARDING_PROMPT.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkorablin/defectdojo-http-api-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "defectdojo",
    "security",
    "findings",
    "http-api"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "publish:npm": "npm publish --access public"
  }
}
